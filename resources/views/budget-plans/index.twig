{% extends './layout/default' %}

{% block content %}
    {% if plans|length == 0 %}
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                <div class="box">
                    <div class="box-header with-border">
                        <h3 class="box-title">No Budget Plans</h3>
                        <div class="box-tools pull-right">
                            <a href="{{ route('budget-plans.create') }}" class="btn btn-success btn-sm">
                                <em class="fa fa-plus fa-fw"></em> Create New Budget Plan
                            </a>
                        </div>
                    </div>
                    <div class="box-body">
                        <p>No budget plan files found. Use the button above to generate an AI-powered budget plan.</p>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        {% for key, group in groups %}
            <div class="row">
                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                    <div class="box {{ key == 'monthly' ? 'box-primary' : 'box-default' }}">
                        <div class="box-header with-border">
                            <h3 class="box-title"><em class="fa {{ key == 'monthly' ? 'fa-book' : 'fa-folder-open-o' }} fa-fw"></em> {{ group.title }}</h3>
                            {% if loop.first %}
                                <div class="box-tools pull-right">
                                    <a href="{{ route('budget-plans.create') }}" class="btn btn-success btn-sm">
                                        <em class="fa fa-plus fa-fw"></em> Create New Budget Plan
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                        <div class="box-body no-padding">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 15%;">Month</th>
                                        <th>Plan</th>
                                        <th>Last Modified</th>
                                        <th class="text-right">Size</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for plan in group.plans %}
                                        <tr>
                                            <td>{{ plan.period }}</td>
                                            <td>
                                                <a href="{{ route('budget-plans.show', plan.path) }}">
                                                    <em class="fa fa-file-text-o fa-fw"></em>
                                                    {{ plan.name }}
                                                </a>
                                            </td>
                                            <td>{{ plan.modified }}</td>
                                            <td class="text-right">
                                                {{ (plan.size / 1024)|number_format(1) }} KB
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}
